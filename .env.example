# --- Servidor ---
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Base de dados ---
DATABASE_URL=postgres://obramz:obramz@localhost:5432/obramz
PGPOOL_MAX=10

# --- Autenticacao ---
# Obrigatorio em producao: openssl rand -hex 32
JWT_SECRET=trocar-este-segredo-em-producao-por-favor
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=10

# --- Dominio ---
MOEDA_BASE=MZN
# true = bloqueia lancamento de itens que estouram o orcamento total da obra
BUDGET_STRICT=false
# true = permite saida de stock acima do saldo
STOCK_PERMITE_NEGATIVO=false
HORAS_POR_DIA=8

# --- Uploads ---
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_BASE_URL=/uploads

# --- Sync ---
SYNC_PAGE_MAX=500

# --- PaySuite (gateway de pagamentos de Mocambique) ---
# Integracao desligada enquanto PAYSUITE_API_KEY nao estiver definida.
# ATENCAO: a PaySuite NAO tem sandbox — com a key definida, as
# transaccoes sao reais. Obtenha a key em dashboard > Settings > API Access.
#PAYSUITE_API_KEY=
# Segredo para verificar webhooks (HMAC-SHA256). Defina em merchant settings.
#PAYSUITE_WEBHOOK_SECRET=
PAYSUITE_BASE_URL=https://paysuite.tech/api/v1