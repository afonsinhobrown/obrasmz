{
  "expo": {
    "name": "ObraMZ",
    "slug": "obramz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.obramz.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir ao ObraMZ escolher fotos para anexar ao diário de obra.",
          "cameraPermission": "Permitir ao ObraMZ usar a câmara para fotografar o diário de obra."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir ao ObraMZ usar a localização para georeferenciar as fotos do diário."
        }
      ]
    ]
  }
}
